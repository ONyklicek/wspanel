#!/usr/bin/env bash
# Installs WSPanel in this container once, from the release in the image,
# with the WSPANEL_* settings of the container (compose.yaml / .env):
#
#   WSPANEL_PANEL_DOMAIN   panel.example.com (empty: the server's address and WSPANEL_PANEL_PORT)
#   WSPANEL_PANEL_PORT     the panel's port without a domain of its own (default 8443)
#   WSPANEL_ACME_EMAIL     Let's Encrypt account
#   WSPANEL_ADMIN_EMAIL    the first panel account (required)
#   WSPANEL_DB             none | mariadb | postgres | mariadb,postgres (default mariadb)
#   WSPANEL_PHP            PHP-FPM versions, e.g. 8.3,8.4 (default 8.4)
#   WSPANEL_PUBLIC_SSH_PORT / WSPANEL_PUBLIC_HTTPS_PORT   ports as the host publishes them
#   WSPANEL_PUBLIC_IPV4    the public address (behind NAT / Docker Desktop)
#   WSPANEL_SSH_KEY        a public key for root
#   WSPANEL_LOCAL_CERTS    1: the panel's own CA instead of Let's Encrypt (tests)
#   WSPANEL_SOCKET_BIND    auto | enforced | unenforced (auto: unenforced on Docker Desktop)
#   WSPANEL_ARGS           more installer flags (docs/instalace.md), space-separated
#   WSPANEL_RESTORE        a server backup (.wspbak) inside the container, e.g. /restore/server-….wspbak:
#                          the old server restored instead (its choices; the settings above but
#                          WSPANEL_ARGS are not used), with WSPANEL_RECOVERY_KEY (and --backups=… in WSPANEL_ARGS)
#
# A failed installation leaves no mark: the next start of the container
# tries again (the installer is idempotent).
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
marker=/var/lib/wspanel-docker/installed
log=/var/log/wspanel-docker-setup.log
[[ -e $marker ]] && exit 0

# shellcheck source=/dev/null
[[ -f /etc/wspanel-docker/setup.env ]] && . /etc/wspanel-docker/setup.env

say() { printf '\033[1;34m[wspanel]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[wspanel] ERROR:\033[0m %s\n' "$*"; exit 1; }

finish() {
  install -d -m 0700 /var/lib/wspanel-docker
  date -u +%FT%TZ > "$marker"
  url="$(sed -n 's/^APP_URL=//p' /srv/panel/shared/.env 2>/dev/null || true)"
  say "Done. Panel: ${url:-?}  $1"
}
install -m 0600 /dev/null "$log"

if [[ -n "${WSPANEL_RESTORE:-}" ]]; then
  [[ -f $WSPANEL_RESTORE ]] || die "WSPANEL_RESTORE: $WSPANEL_RESTORE is not in the container (mount its folder, docs/docker.md)"
  [[ -n "${WSPANEL_RECOVERY_KEY:-}" ]] || die "WSPANEL_RESTORE needs WSPANEL_RECOVERY_KEY"
  say "Restoring the server backup $WSPANEL_RESTORE (log: $log)"
  # shellcheck disable=SC2086 # space-separated flags on purpose
  if ! /opt/wspanel-image/install --yes "--restore=$WSPANEL_RESTORE" ${WSPANEL_ARGS:-} </dev/null 2>&1 | tee -a "$log"; then
    die "restore failed: docker exec <container> tail -80 $log"
  fi
  finish "(the old server's accounts; remove WSPANEL_RECOVERY_KEY from .env now)"
  exit 0
fi

[[ -n "${WSPANEL_ADMIN_EMAIL:-}" ]] || die "WSPANEL_ADMIN_EMAIL is not set (compose.yaml / .env)"

flags=(--yes "--admin-email=$WSPANEL_ADMIN_EMAIL" "--db=${WSPANEL_DB:-mariadb}" "--php=${WSPANEL_PHP:-8.4}")
if [[ -n "${WSPANEL_PANEL_DOMAIN:-}" ]]; then
  flags+=("--panel-domain=$WSPANEL_PANEL_DOMAIN")
  [[ -n "${WSPANEL_PANEL_PORT:-}" ]] && flags+=("--panel-port=$WSPANEL_PANEL_PORT")
else
  flags+=("--panel-port=${WSPANEL_PANEL_PORT:-8443}")
fi
[[ -n "${WSPANEL_ACME_EMAIL:-}" ]] && flags+=("--acme-email=$WSPANEL_ACME_EMAIL")
[[ -n "${WSPANEL_PUBLIC_SSH_PORT:-}" ]] && flags+=("--public-ssh-port=$WSPANEL_PUBLIC_SSH_PORT")
[[ -n "${WSPANEL_PUBLIC_HTTPS_PORT:-}" ]] && flags+=("--public-https-port=$WSPANEL_PUBLIC_HTTPS_PORT")
[[ -n "${WSPANEL_PUBLIC_IPV4:-}" ]] && flags+=("--public-ipv4=$WSPANEL_PUBLIC_IPV4")
[[ -n "${WSPANEL_SSH_KEY:-}" ]] && flags+=("--ssh-key=$WSPANEL_SSH_KEY")
[[ "${WSPANEL_LOCAL_CERTS:-0}" == 1 ]] && flags+=(--local-certs)

# Docker Desktop (Windows: WSL2's kernel, Mac: LinuxKit) does not enforce
# cgroup BPF socket-bind: without the exception the agent refuses Node and
# Reverb (docs/bezpecnost.md). A Linux host with Docker Engine enforces it.
case "${WSPANEL_SOCKET_BIND:-auto}" in
  unenforced) flags+=(--allow-unenforced-socket-bind) ;;
  enforced) ;;
  auto) [[ "$(uname -r)" =~ microsoft|WSL|linuxkit ]] && flags+=(--allow-unenforced-socket-bind) ;;
  *) die "WSPANEL_SOCKET_BIND must be auto, enforced or unenforced" ;;
esac

# shellcheck disable=SC2206 # space-separated flags on purpose
[[ -n "${WSPANEL_ARGS:-}" ]] && flags+=($WSPANEL_ARGS)

say "Installing WSPanel $(cat /opt/wspanel-image/VERSION) (log: $log; takes a few minutes)"
if ! /opt/wspanel-image/install "${flags[@]}" </dev/null 2>&1 | tee -a "$log"; then
  die "installation failed: docker exec <container> tail -80 $log (restart the container to try again)"
fi
finish "(account and password above; also in $log)"
