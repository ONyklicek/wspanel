[Unit]
Description=WSPanel: installation on the container's first start
Documentation=file:///opt/wspanel-image/docs/docker.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/wspanel-docker/installed

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wspanel-docker-setup
# docker logs shows it: the console is the container's terminal (tty).
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=infinity
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
