# WSPanel in Docker: settings of the first start (docs/docker.md). Changing
# them later changes nothing: the installed server keeps its own settings.

# The image's version (a release, never "latest": a new tag recreates the
# container and wipes the server). Upgrades go through the panel.
WSPANEL_TAG=1.10.0

# The first panel account (its password appears in docker compose logs).
WSPANEL_ADMIN_EMAIL=admin@example.com

# The panel's own domain (A record to this machine's public address) and the
# Let's Encrypt account. Empty domain: https://<address>:WSPANEL_PANEL_PORT
# (default 8443). With a domain, the port only when not 443.
WSPANEL_PANEL_DOMAIN=
WSPANEL_ACME_EMAIL=
WSPANEL_PANEL_PORT=

# Databases: none | mariadb | postgres | mariadb,postgres ; PHP-FPM versions.
WSPANEL_DB=mariadb
WSPANEL_PHP=8.4

# Ports on this machine (what the panel tells clients), and its public
# address (Docker Desktop: detected wrong, set it).
WSPANEL_PUBLIC_HTTPS_PORT=443
WSPANEL_PUBLIC_SSH_PORT=2222
WSPANEL_PUBLIC_IPV4=

# A public key for root inside the container (optional).
WSPANEL_SSH_KEY=

# More installer flags (docs/instalace.md), e.g.
# WSPANEL_ARGS=--mail-hosting=yes --clients=yes --node=24
WSPANEL_ARGS=

# auto | enforced | unenforced (auto: unenforced on Docker Desktop).
WSPANEL_SOCKET_BIND=auto

# A new container from a server backup instead of an empty one (moving to a
# new image, a new machine): the .wspbak in ./restore, and its key.
# WSPANEL_RESTORE=/restore/server-20261109T021800Z.wspbak
# WSPANEL_RECOVERY_KEY=
