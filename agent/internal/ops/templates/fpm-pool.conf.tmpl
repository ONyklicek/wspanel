; Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
; site: {{.Domain}}  framework: {{.Framework}}
[{{.User}}]
user = {{.User}}
group = {{.User}}

listen = {{.Socket}}
listen.owner = {{.WebUser}}
listen.group = {{.WebUser}}
listen.mode = 0660

pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 30s
pm.max_requests = 1000

chdir = /
catch_workers_output = yes
decorate_workers_output = no
security.limit_extensions = .php

env[TMPDIR] = {{.Home}}/tmp
php_admin_value[open_basedir] = {{.Home}}/
php_admin_value[upload_tmp_dir] = {{.Home}}/tmp
php_admin_value[sys_temp_dir] = {{.Home}}/tmp
php_admin_value[session.save_path] = {{.Home}}/tmp
php_admin_value[error_log] = {{.Home}}/logs/php-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
php_admin_value[disable_functions] = {{.DisableFunctions}}
; mail(): {{.MailMode}} ({{if eq .MailMode "capture"}}Mailpit, nothing leaves the server{{else}}local Postfix, DKIM-signed{{end}})
php_admin_value[sendmail_path] = "{{.SendmailPath}}"
{{- if .OpcacheProduction}}
; Production OPcache: no file stat on each request. Code changes take effect
; on the FPM reload every deploy does (manual edits need a reload too).
php_admin_flag[opcache.validate_timestamps] = off
{{- end}}
