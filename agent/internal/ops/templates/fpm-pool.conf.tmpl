; Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
; site: {{.Domain}}  framework: {{.Framework}}
[{{.User}}]
user = {{.User}}

listen = {{.Socket}}
listen.owner = {{.WebUser}}
listen.group = {{.WebUser}}
listen.mode = 0660

pm = ondemand
pm.max_children = {{.FPMChildren}}
; A worker stays two minutes after its last request: the next visitor gets a
; warm worker, not a fork and a cold start.
pm.process_idle_timeout = 120s
pm.max_requests = 1000
; Wall-clock limit of one request (see RequestTerminateTimeout). No slowlog:
; the master opens it as root at start, and in the site's own tree a missing
; directory would stop FPM for every site and a symlink would aim root's
; writes anywhere.
request_terminate_timeout = {{.RequestTerminateTimeout}}s

chdir = /
catch_workers_output = yes
decorate_workers_output = no
security.limit_extensions = .php

env[TMPDIR] = {{.Home}}/tmp
php_admin_value[open_basedir] = {{.Home}}/{{if .Xhprof}}:{{.XhguiDir}}/{{end}}
php_admin_value[upload_tmp_dir] = {{.Home}}/tmp
php_admin_value[sys_temp_dir] = {{.Home}}/tmp
php_admin_value[session.save_path] = {{.Home}}/tmp
php_admin_value[error_log] = {{.Home}}/logs/php-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = {{if .DisplayErrors}}on{{else}}off{{end}}
php_admin_value[disable_functions] = {{.DisableFunctions}}
; mail(): {{.MailMode}} ({{if eq .MailMode "capture"}}Mailpit, nothing leaves the server{{else}}local Postfix, DKIM-signed{{end}})
php_admin_value[sendmail_path] = "{{.SendmailPath}}"
{{- if .PHPValues}}
; PHP settings from the panel (the application may still raise them with ini_set)
{{- range .PHPValues}}
php_{{if .Flag}}flag{{else}}value{{end}}[{{.Key}}] = {{.Value}}
{{- end}}
{{- end}}
{{- if .OpcacheProduction}}
; Production OPcache: no file stat on each request. Code changes take effect
; on the FPM reload every deploy does (manual edits need a reload too).
php_admin_flag[opcache.validate_timestamps] = off
{{- end}}
{{- if .Xhprof}}
; XHProf: {{.XhprofRatio}} % of requests profiled into the site's own XHGui ({{.Home}}/xhgui).
php_admin_value[extension] = xhprof.so
php_admin_value[auto_prepend_file] = {{.XhguiDir}}/prepend.php
env[WSP_XHGUI_SPOOL] = {{.Home}}/xhgui/spool.jsonl
env[WSP_XHGUI_RATIO] = {{.XhprofRatio}}
{{- end}}
