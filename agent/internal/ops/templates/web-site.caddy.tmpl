# Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
# site: {{.Domain}}  mode: classic  php: {{.PHPVersion}}  framework: {{.Framework}}
http://{{.Domain}} {
	root * {{.Home}}/current/public

	@hidden {
		path */.*
		not path /.well-known/*
	}
{{- if .Xhprof}}

	# XHGui of this site (the edge lets in only a panel sign-in): XHGui's code,
	# the site's own profiles, the site's own pool.
	handle_path /_wsp_xhgui/* {
		root * {{.XhguiDir}}/xhgui/webroot
		php_fastcgi unix/{{.Socket}} {
			env XHGUI_SAVE_HANDLER pdo
			env XHGUI_PDO_DSN sqlite:{{.Home}}/xhgui/xhgui.sqlite3
			env XHGUI_PATH_PREFIX /_wsp_xhgui
			env WSP_XHGUI_SPOOL {{.Home}}/xhgui/spool.jsonl
			# Slim takes the prefix as its base path (routes see what is below it).
			env SCRIPT_NAME /_wsp_xhgui/index.php
			env HTTPS on
			env SERVER_PORT 443
			env REMOTE_ADDR {http.request.header.X-Forwarded-For}
		}
		file_server
	}
{{- end}}

{{- if eq .Framework "laravel"}}

	# Vite's build output carries a hash in every name: a browser keeps it for
	# a year without asking again; a new build has new names.
	@wsp_hashed {
		path /build/assets/*
		file
	}
	header @wsp_hashed Cache-Control "public, max-age=31536000, immutable"
{{- end}}

	# In this order (Caddy would put a reverse_proxy before php_fastcgi):
	# hidden files, PHP to the site's pool, any other existing file to the
	# static file server.
	route {
		respond @hidden 404

		php_fastcgi unix/{{.Socket}} {
			resolve_root_symlink
			# PHP-FPM being restarted (a PHP update, a new version of the pool's
			# settings) is waited for: its socket is back within a second or two,
			# and a request that could not connect was never sent, so it is
			# retried safely, whatever its method.
			lb_try_duration 5s
			lb_try_interval 100ms
			# Only the edge reaches this server; it terminates TLS.
			env HTTPS on
			env SERVER_PORT 443
			env REMOTE_ADDR {http.request.header.X-Forwarded-For}
		}
{{- if .StaticSocket}}
		# The file itself is read by the static file server (nginx), which opens
		# no symlink whose target is another owner's: this server only knows
		# that it exists. A .br / .gz next to it (a build step's output) is sent
		# as it is.
		reverse_proxy unix/{{.StaticSocket}} {
			header_up X-Wsp-Root {{.Home}}/current/public
			lb_try_duration 5s
			lb_try_interval 100ms
		}
{{- else}}
		# A .br / .zst / .gz next to a file (a build step's output) is sent as it is.
		file_server {
			precompressed zstd br gzip
		}
{{- end}}
	}
}
