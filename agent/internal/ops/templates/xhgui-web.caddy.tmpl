# Managed by WSPanel agent. XHGui of {{.Domain}}: runs in the site's own FPM
# pool (as its user, reading only its own profiles). The edge lets in only
# panel users who may see the site (forward_auth to the panel).
handle_path /xhgui/{{.Domain}}/* {
	root * {{.XhguiDir}}/xhgui/webroot
	php_fastcgi unix/{{.Socket}} {
		env XHGUI_SAVE_HANDLER pdo
		env XHGUI_PDO_DSN sqlite:{{.Home}}/xhgui/xhgui.sqlite3
		env XHGUI_PATH_PREFIX /xhgui/{{.Domain}}
		env WSP_XHGUI_SPOOL {{.Home}}/xhgui/spool.jsonl
		# Slim takes the prefix as its base path (routes see what is below it).
		env SCRIPT_NAME /xhgui/{{.Domain}}/index.php
		env HTTPS on
		env SERVER_PORT 443
		env REMOTE_ADDR {http.request.header.X-Forwarded-For}
	}
	file_server
}
