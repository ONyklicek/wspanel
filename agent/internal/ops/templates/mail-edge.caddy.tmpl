# Managed by WSPanel agent (mail.json). Per mail domain: its webmail and the
# addresses mail clients look up their settings at. Do not edit by hand.
{{- range .Domains}}
{{- if .Webmail}}

webmail.{{.Name}} {
	encode zstd gzip
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log
	reverse_proxy unix//run/panel-web/web.sock {
		header_up Host wspanel-webmail.internal
		header_up X-Wsp-Mail-Domain {{.Name}}
	}
}
{{- end}}
{{- if .Autoconfig}}

autoconfig.{{.Name}}, autodiscover.{{.Name}} {
	header -Server
	# Thunderbird (and others reading its format).
	@thunderbird path /mail/config-v1.1.xml /.well-known/autoconfig/mail/config-v1.1.xml
	header @thunderbird Content-Type "application/xml; charset=utf-8"
	respond @thunderbird `<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="{{.Name}}">
    <domain>{{.Name}}</domain>
    <displayName>{{.Name}}</displayName>
    <displayShortName>{{.Name}}</displayShortName>
    <incomingServer type="imap">
      <hostname>{{$.Host}}</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <incomingServer type="pop3">
      <hostname>{{$.Host}}</hostname>
      <port>995</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>{{$.Host}}</hostname>
      <port>465</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
</clientConfig>
` 200
	# Outlook (POX autodiscover).
	@outlook path_regexp (?i)^/autodiscover/autodiscover\.xml$
	header @outlook Content-Type "application/xml; charset=utf-8"
	respond @outlook `<?xml version="1.0" encoding="utf-8"?>
<Autodiscover xmlns="http://schemas.microsoft.com/exchange/autodiscover/responseschema/2006">
  <Response xmlns="http://schemas.microsoft.com/exchange/autodiscover/outlook/responseschema/2006a">
    <Account>
      <AccountType>email</AccountType>
      <Action>settings</Action>
      <Protocol>
        <Type>IMAP</Type>
        <Server>{{$.Host}}</Server>
        <Port>993</Port>
        <DomainRequired>off</DomainRequired>
        <SPA>off</SPA>
        <SSL>on</SSL>
        <AuthRequired>on</AuthRequired>
      </Protocol>
      <Protocol>
        <Type>SMTP</Type>
        <Server>{{$.Host}}</Server>
        <Port>465</Port>
        <DomainRequired>off</DomainRequired>
        <SPA>off</SPA>
        <SSL>on</SSL>
        <AuthRequired>on</AuthRequired>
        <UsePOPAuth>on</UsePOPAuth>
      </Protocol>
    </Account>
  </Response>
</Autodiscover>
` 200
	respond 404
}
{{- end}}
{{- end}}
