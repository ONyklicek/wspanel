# Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
# The site's own Valkey: 127.0.0.1:{{.Port}} and a unix socket, both behind the site's password.
bind 127.0.0.1
port {{.Port}}
unixsocket {{.Socket}}
unixsocketperm 700
protected-mode yes
daemonize no
supervised no
logfile ""
dir {{.DataDir}}
maxmemory {{.MaxMemoryMB}}mb
maxmemory-policy {{.Policy}}
databases 16
appendonly no
{{- if .Persist}}
save 3600 1 300 100 60 10000
{{- else}}
save ""
{{- end}}
# requirepass: copied at start from a root-only file into the 0700 runtime dir
include {{.AuthInclude}}
