# Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
# Worker mode for {{.Domain}} ({{.Framework}}): one FrankenPHP instance running
# as {{.User}}. It serves static files itself, so it can only ever expose
# what that user can read. Reached by the edge proxy over a Unix socket.
{
	# Admin API on a socket only the site user (and root) can open: the agent
	# restarts the PHP workers through it after a deploy, without dropping
	# connections.
	admin unix/{{.RunDir}}/admin.sock|0600
	auto_https off
	persist_config off
	servers {
		protocols h1
	}
{{- if or .PHPValues .DisplayErrors}}
	frankenphp {
		# PHP settings from the panel
{{- range .PHPValues}}
		php_ini {{.Key}} {{.Value}}
{{- end}}
		php_ini display_errors {{if .DisplayErrors}}On{{else}}Off{{end}}
	}
{{- end}}
}

http:// {
	bind unix/{{.AppSocket}}|0220
	root * {{.Home}}/current/public

	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404

	php_server {
{{- if .WorkerIndex}}
		index {{.WorkerIndex}}
		try_files {path} {{.WorkerIndex}}
{{- end}}
		# Only the edge reaches this server; it terminates TLS.
		env HTTPS on
		env SERVER_PORT 443
		worker {
			file {{.WorkerFile}}
			num {{.WorkerThreads}}
			# Recycle workers to contain memory leaks of long-running apps.
			env MAX_REQUESTS {{.WorkerMaxReq}}
{{- range .WorkerEnv}}
			env {{.}}
{{- end}}
		}
	}
}
