import os
import platform
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PAGE = ('<!doctype html><html lang="cs"><meta charset="utf-8"><title>{{.Domain}}</title>'
        '<body style="font-family:system-ui;max-width:40rem;margin:4rem auto;padding:0 1rem">'
        '<h1>{{.Domain}}</h1><p>Python web je založený (Python ' + platform.python_version()
        + '). Čeká na první deploy.</p></body></html>').encode()


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Content-Length', str(len(PAGE)))
        self.end_headers()
        self.wfile.write(PAGE)

    def log_message(self, *args):
        pass


ThreadingHTTPServer((os.environ['HOST'], int(os.environ['PORT'])), Handler).serve_forever()
