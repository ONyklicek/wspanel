# Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
# Edge (TLS) for {{.Domain}} ({{.Mode}}). Holds certificates, never touches site files.
{{.EdgeHosts}} {
	encode zstd gzip
{{- if .TLSDirective}}
	{{.TLSDirective}}
{{- end}}
{{- if .Disabled}}

	# The site is switched off in the panel.
	header Content-Type "text/html; charset=utf-8"
	header Retry-After 3600
	respond `<!doctype html><html lang="cs"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Web je dočasně vypnutý</title><body style="font-family:system-ui;max-width:36rem;margin:5rem auto;padding:0 1rem;color:#333"><h1 style="font-size:1.4rem">Web je dočasně vypnutý</h1><p>Správce tento web vypnul. Zkuste to prosím později.</p></body></html>` 503
	log
}
{{- else}}
{{- if .Edge.HSTS}}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
{{- end}}
{{- if .Edge.Security}}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
{{- end}}
{{- range .Edge.Headers}}
	header {{.Name}} "{{.Value}}"
{{- end}}

	# In written order (a route block): who may come in, then redirects, then the app.
	route {
{{- if .Edge.AllowIPs}}
		@wsp_not_allowed {
			path {{.AllowMatcher}}
			not remote_ip{{range .Edge.AllowIPs}} {{.}}{{end}}
		}
		respond @wsp_not_allowed "Přístup odepřen" 403
{{- end}}
{{- if .Edge.AuthPath}}
		@wsp_auth path {{.AuthMatcher}}
		basic_auth @wsp_auth {
			{{.Edge.AuthUser}} {{.Edge.AuthHash}}
		}
{{- end}}
{{- range .Edge.Redirects}}
		redir {{.From}} {{.To}} {{.Code}}
{{- end}}
{{- if .ReverbPort}}

		# Laravel Reverb (WebSockets): /app = client connections, /apps = server API.
		@reverb path /app /app/* /apps /apps/*
		handle @reverb {
			reverse_proxy 127.0.0.1:{{.ReverbPort}}
		}
{{- end}}
		reverse_proxy {{.Upstream}}
	}
	log
}
{{- range .Edge.RedirectHosts}}

# Redirects to the main domain.
{{.}} {
{{- if $.TLSInternal}}
	tls internal
{{- end}}
	redir https://{{$.Domain}}{uri} 308
}
{{- end}}
{{- end}}
