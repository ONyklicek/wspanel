# Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
# Edge (TLS) for {{.Domain}} ({{.Mode}}). Holds certificates, never touches site files.
{{.EdgeHosts}} {
	encode zstd gzip
{{- if .TLSDirective}}
	{{.TLSDirective}}
{{- end}}
{{- if .Disabled}}

	# The site is switched off in the panel.
	header Content-Type "text/html; charset=utf-8"
	header Retry-After 3600
	respond `<!doctype html><html lang="cs"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Web je dočasně vypnutý</title><body style="font-family:system-ui;max-width:36rem;margin:5rem auto;padding:0 1rem;color:#333"><h1 style="font-size:1.4rem">Web je dočasně vypnutý</h1><p>Správce tento web vypnul. Zkuste to prosím později.</p></body></html>` 503
	# Per-site access log (the panel's traffic stats read it).
	log {
		output file {{$.AccessLog}} {
			roll_size 20MiB
			roll_keep 3
		}
		format json
	}
}
{{- else}}
{{- if .Edge.HSTS}}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
{{- end}}
{{- if .Edge.Security}}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
{{- end}}
{{- range .Edge.Headers}}
	header {{.Name}} "{{.Value}}"
{{- end}}

	# In written order (a route block): who may come in, then redirects, then the app.
	route {
{{- if .HookID}}
		# This site's deploy webhook through its public domain, for a panel the
		# internet does not reach (set by the panel): exactly this site's hook
		# path, ahead of the site's own access rules; the panel checks each
		# delivery's signature and takes it once.
		@wsp_deploy_hook path /.well-known/wspanel-deploy/{{.HookID}}
		handle @wsp_deploy_hook {
			rewrite * /hooks/deploy/{{.HookID}}
			reverse_proxy unix/{{.WebSocket}} {
				header_up Host wspanel-panel.internal
				header_up X-Forwarded-For {remote_host}
			}
		}
{{- end}}
{{- if .Edge.AllowIPs}}
		@wsp_not_allowed {
			{{.AllowMatcher}}
			not remote_ip{{range .Edge.AllowIPs}} {{.}}{{end}}
		}
		respond @wsp_not_allowed "Přístup odepřen" 403
{{- end}}
{{- if .Edge.AuthPath}}
		@wsp_auth {{.AuthMatcher}}
		basic_auth @wsp_auth {
			{{.Edge.AuthUser}} {{.Edge.AuthHash}}
		}
{{- end}}
{{- if .Maintenance}}

		# Maintenance page (a deploy's migrations). The bypass link sets a cookie.
		@wsp_maint_enter query wsp_maintenance={{.Maintenance}}
		header @wsp_maint_enter Set-Cookie "wsp_maintenance={{.Maintenance}}; Path=/; Secure; HttpOnly; SameSite=Lax"
		@wsp_maint {
			not header Cookie *wsp_maintenance={{.Maintenance}}*
			not query wsp_maintenance={{.Maintenance}}
		}
		header @wsp_maint Retry-After 60
		header @wsp_maint Content-Type "text/html; charset=utf-8"
		respond @wsp_maint `<!doctype html><html lang="cs"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta http-equiv="refresh" content="15"><title>Probíhá údržba</title><body style="font-family:system-ui;max-width:36rem;margin:5rem auto;padding:0 1rem;color:#333"><h1 style="font-size:1.4rem">Probíhá krátká údržba</h1><p>Web bude za chvíli zpět. Stránka se sama obnoví.</p></body></html>` 503
{{- end}}
{{- range .Edge.Redirects}}
		redir {{.From}} {{.To}} {{.Code}}
{{- end}}
{{- if .Directives}}

		# Custom rules of the site (panel: Další → Pravidla webserveru).
{{.Directives}}
{{- end}}
{{- if .Xhprof}}

		# The site's XHGui (XHProf profiles), on the site's own origin: only after
		# a sign-in link from the panel for this very domain (forward_auth).
		handle /_wsp_xhgui/* {
			forward_auth unix/{{.WebSocket}} {
				uri /auth/xhgui/{{.Domain}}
				header_up Host wspanel-panel.internal
			}
			reverse_proxy {{.Upstream}}
		}
{{- end}}
{{- if .ReverbPort}}

		# Laravel Reverb: browsers' WebSockets (/app). The app publishes to Reverb
		# on 127.0.0.1 directly, so its HTTP API (/apps) is not exposed.
		@reverb path /app /app/*
		handle @reverb {
			reverse_proxy 127.0.0.1:{{.ReverbPort}}
		}
{{- end}}
		reverse_proxy {{.Upstream}}
	}
	# Per-site access log (the panel's traffic stats read it).
	log {
		output file {{$.AccessLog}} {
			roll_size 20MiB
			roll_keep 3
		}
		format json
	}
}
{{- range .Edge.RedirectHosts}}

# Redirects to the main domain.
{{.}} {
{{- if $.TLSInternal}}
	tls internal
{{- end}}
	redir https://{{$.Domain}}{uri} 308
}
{{- end}}
{{- end}}
