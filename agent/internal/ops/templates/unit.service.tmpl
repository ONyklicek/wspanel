# Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
[Unit]
Description={{.Description}}
After=network.target
{{- if not .Oneshot}}
# Never given up on: a process that failed while its database or the network
# was restarting comes back on its own, after a pause that grows with each
# failure in a row (RestartSteps up to RestartMaxDelaySec).
StartLimitIntervalSec=0
{{- end}}

[Service]
Type={{if .Oneshot}}oneshot{{else}}simple{{end}}
User={{.User}}
WorkingDirectory={{if .WorkDir}}{{.WorkDir}}{{else}}{{.Home}}/current{{end}}
ExecStart={{.ExecStart}}
{{- if .Oneshot}}
TimeoutStartSec=1h
{{- else}}
Restart=always
RestartSec={{or .RestartSec "2s"}}
RestartSteps=5
RestartMaxDelaySec={{or .RestartMaxDelay "30s"}}
{{- end}}
KillSignal=SIGTERM
TimeoutStopSec={{.StopTimeout}}
Environment=TMPDIR={{.Home}}/tmp
Environment=HOME={{.Home}}/tmp
{{- range .Environment}}
Environment={{.}}
{{- end}}
UMask=0027
# A safety net, not a quota: one site's leaking app or a fork bomb in a
# worker must not take the whole server. Under memory pressure a site's
# process goes before the web tier and the databases (a game server before
# it). The lines below may set their own (a game's limit).
MemoryHigh=50%
MemoryMax=60%
TasksMax=2048
OOMScoreAdjust=300
{{- range .Extra}}
{{.}}
{{- end}}

# Sandbox: the process runs arbitrary application code, so it gets as little
# of the system as possible. Writable: only its own site.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{.Home}}{{if .RunDir}} {{.RunDir}}{{end}}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/etc/panel-agent -/var/lib/panel-agent -/var/log/panel-agent -/var/lib/panel-proxy -/etc/panel-proxy
{{- if not .Oneshot}}

[Install]
WantedBy=multi-user.target
{{- end}}
