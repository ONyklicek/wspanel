# Managed by WSPanel agent. Do not edit: changes are overwritten by the panel.
[Unit]
Description={{.Description}}
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User={{.User}}
WorkingDirectory={{.Home}}/current
ExecStart={{.ExecStart}}
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec={{.StopTimeout}}
Environment=TMPDIR={{.Home}}/tmp
Environment=HOME={{.Home}}/tmp
{{- range .Environment}}
Environment={{.}}
{{- end}}
UMask=0027
{{- range .Extra}}
{{.}}
{{- end}}

# Sandbox: the process runs arbitrary application code, so it gets as little
# of the system as possible. Writable: only its own site.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{.Home}}{{if .RunDir}} {{.RunDir}}{{end}}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/etc/panel-agent -/var/lib/panel-agent -/var/log/panel-agent -/var/lib/panel-proxy -/etc/panel-proxy

[Install]
WantedBy=multi-user.target
