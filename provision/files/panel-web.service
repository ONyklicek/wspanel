[Unit]
Description=WSPanel web tier (routing to PHP-FPM and to the static files, FrankenPHP/Caddy)
After=network.target panel-static.service
Wants=panel-static.service

[Service]
Type=notify
User=panel-web
Group=panel-web
# Reaches the static file server's socket (/run/panel-static, group panel-static).
SupplementaryGroups=panel-static
ExecStart=/usr/bin/frankenphp run --config /etc/panel-web/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/frankenphp reload --config /etc/panel-web/Caddyfile --adapter caddyfile --address unix//run/panel-web/admin.sock --force
Restart=on-failure
TimeoutStopSec=15s
LimitNOFILE=1048576
# Every site depends on it: under memory pressure the kernel keeps it in RAM
# (MemoryLow) and kills it last (OOMScoreAdjust), never a swapped-out edge
# answering in tens of seconds while a game server eats the RAM.
MemoryLow=128M
OOMScoreAdjust=-800
Environment=XDG_DATA_HOME=/var/lib/panel-web XDG_CONFIG_HOME=/var/lib/panel-web/config
StateDirectory=panel-web
StateDirectoryMode=0700
# 0750 + group panel-web: only the edge proxy can reach web.sock.
RuntimeDirectory=panel-web
RuntimeDirectoryMode=0750
UMask=0007
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/etc/panel-agent -/var/lib/panel-agent -/var/log/panel-agent -/var/lib/panel-proxy -/etc/panel-proxy

[Install]
WantedBy=multi-user.target
