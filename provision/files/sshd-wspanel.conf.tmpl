# Managed by WSPanel install.sh.
# Administrators log in with keys, and with a password too when the installer
# was told so (--ssh-password=yes; fail2ban bans repeated failures). Site users
# authenticate with keys the panel manages in root-owned
# /etc/ssh/authorized_keys/<user> (they cannot add their own) or, when enabled
# in the panel, a password (locked otherwise).
PasswordAuthentication __PASSWORD__
KbdInteractiveAuthentication no
PermitRootLogin __ROOT_LOGIN__

Match Group wspanel-ssh,wspanel-sftp
	AuthorizedKeysFile /etc/ssh/authorized_keys/%u
	PasswordAuthentication yes
	# No tunnels into local services (databases, other sites' backends).
	AllowTcpForwarding no
	AllowStreamLocalForwarding no
	GatewayPorts no
	PermitTunnel no
	X11Forwarding no
	AllowAgentForwarding no
	PermitUserRC no

Match Group wspanel-sftp
	ForceCommand internal-sftp -d %d
	PermitTTY no
