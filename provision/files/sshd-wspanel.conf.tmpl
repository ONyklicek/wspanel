# Managed by WSPanel install.sh.
# Server accounts log in with keys only. Site users authenticate with keys the
# panel manages in root-owned /etc/ssh/authorized_keys/<user> (they cannot add
# their own) or, when enabled in the panel, a password (locked otherwise;
# fail2ban bans repeated failures).
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin __ROOT_LOGIN__

Match Group wspanel-ssh,wspanel-sftp
	AuthorizedKeysFile /etc/ssh/authorized_keys/%u
	PasswordAuthentication yes
	# No tunnels into local services (databases, other sites' backends).
	AllowTcpForwarding no
	AllowStreamLocalForwarding no
	GatewayPorts no
	PermitTunnel no
	X11Forwarding no
	AllowAgentForwarding no
	PermitUserRC no

Match Group wspanel-sftp
	ForceCommand internal-sftp -d %d
	PermitTTY no
