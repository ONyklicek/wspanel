# Managed by WSPanel install.sh. Site blocks live in sites/*.caddy and are
# generated by the panel agent. Do not edit by hand.
{
	# Admin API only on a socket inside a 0700 runtime dir: local users cannot
	# reconfigure the proxy.
	admin unix//run/panel-proxy/admin.sock
	email __ACME_EMAIL__
	servers {
		protocols h1 h2 h3
	}
}

__PANEL_DOMAIN__ {
	root * /srv/panel/current/public
	encode zstd gzip
	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404
	php_fastcgi unix//run/php/php8.4-panel.sock {
		resolve_root_symlink
	}
	file_server
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	log
}

import /etc/panel-proxy/sites/*.caddy
