# Managed by WSPanel install.sh. Edge proxy: terminates TLS and holds the
# certificates. It has NO access to site files (InaccessiblePaths=/srv) and
# only forwards to the web tier over a Unix socket. Site blocks live in
# sites/*.caddy and are generated by the panel agent. Do not edit by hand.
{
	# Admin API only on a socket inside a 0700 runtime dir.
	admin unix//run/panel-proxy/admin.sock
	email __ACME_EMAIL__
	# Internal-TLS sites use the edge's local CA; it is distributed to clients
	# by the operator (SSL → Kořenový certifikát), never installed system-wide.
	skip_install_trust
	servers {
		protocols h1 h2 h3
	}
}

__PANEL_DOMAIN__ {
	encode zstd gzip
	# Who may open the panel (set in the panel: Firewall → Přístup k panelu).
	import /etc/panel-proxy/panel-access.caddy

	# Mailpit (captured test mail): only for users logged in to the panel.
	# The panel answers /auth/check with 204 (or redirects to its login).
	handle /mailpit* {
		forward_auth unix//run/panel-web/web.sock {
			uri /auth/check
		}
		# Message bodies are attacker-controlled HTML (any site can send mail):
		# render them as an opaque origin, so nothing in them can act as the
		# logged-in panel user.
		@message path /mailpit/view/* /mailpit/api/v1/message/*
		header @message Content-Security-Policy "sandbox allow-popups allow-popups-to-escape-sandbox"
		header @message X-Content-Type-Options nosniff
		reverse_proxy 127.0.0.1:8025 {
			header_up Authorization "Basic __MAILPIT_BASIC__"
		}
	}

	handle {
		reverse_proxy unix//run/panel-web/web.sock
	}
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	log
}

import /etc/panel-proxy/sites/*.caddy
