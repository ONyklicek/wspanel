[Unit]
Description=WSPanel privileged agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/panel-agent -config /etc/panel-agent/agent.json
Restart=on-failure
RestartSec=2s
User=root
StateDirectory=panel-agent
StateDirectoryMode=0700
LogsDirectory=panel-agent
LogsDirectoryMode=0700
UMask=0077
PrivateTmp=yes
ProtectHome=yes
# No NoNewPrivileges: combined with the narrowed bounding set below, systemd
# drops CAP_SETUID from the agent, and the agent needs it to run commands as
# a site user (setpriv). It runs as root already, so NNP would add little.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
