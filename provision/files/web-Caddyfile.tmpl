# Managed by WSPanel install.sh. Web tier: serves static files and routes PHP
# to FPM. Plain HTTP on a Unix socket reachable only by the edge proxy. It
# holds no secrets, and its user may read only public/ dirs: Caddy follows
# symlinks, so this is what keeps a site from exposing anything else.
{
	admin unix//run/panel-web/admin.sock
	auto_https off
	default_bind unix//run/panel-web/web.sock|0220
	# A stop or a reload lets requests in flight finish for up to 10 s
	# (systemd waits 15 s) instead of cutting them off.
	grace_period 10s
	servers {
		protocols h1
	}
}

# The panel, under the internal name the edge gives it (never a site's domain).
http://wspanel-panel.internal {
	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404

	# phpMyAdmin and Adminer: own pool, sign-in only via agent tokens.
	handle /dbtools/* {
		root * /usr/share/wspanel-dbtools
		php_fastcgi unix//run/php/php8.4-dbtools.sock {
			env HTTPS on
			env SERVER_PORT 443
			env REMOTE_ADDR {http.request.header.X-Forwarded-For}
		}
		file_server
	}

	handle {
		root * /srv/panel/current/public
		php_fastcgi unix//run/php/php8.4-panel.sock {
			resolve_root_symlink
			env HTTPS on
			env SERVER_PORT 443
			env REMOTE_ADDR {http.request.header.X-Forwarded-For}
		}
		file_server
	}
}

# Roundcube, when mail hosting is installed (mail-hosting.sh).
import /etc/panel-web/webmail*.caddy
import /etc/panel-web/sites/*.caddy
