[Unit]
Description=WSPanel reverse proxy (FrankenPHP/Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=panel-proxy
Group=panel-proxy
ExecStart=/usr/local/bin/frankenphp run --config /etc/panel-proxy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/frankenphp reload --config /etc/panel-proxy/Caddyfile --adapter caddyfile --address unix//run/panel-proxy/admin.sock --force
Restart=on-failure
TimeoutStopSec=5s
LimitNOFILE=1048576
Environment=XDG_DATA_HOME=/var/lib/panel-proxy XDG_CONFIG_HOME=/var/lib/panel-proxy/config
StateDirectory=panel-proxy
StateDirectoryMode=0700
RuntimeDirectory=panel-proxy
RuntimeDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
