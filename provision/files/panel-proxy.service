[Unit]
Description=WSPanel edge proxy (TLS, FrankenPHP/Caddy)
After=network-online.target panel-web.service
Wants=network-online.target

[Service]
Type=notify
User=panel-proxy
Group=panel-proxy
# Membership in panel-web grants access to the web tier's socket directory.
SupplementaryGroups=panel-web
ExecStart=/usr/bin/frankenphp run --config /etc/panel-proxy/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/frankenphp reload --config /etc/panel-proxy/Caddyfile --adapter caddyfile --address unix//run/panel-proxy/admin.sock --force
Restart=on-failure
TimeoutStopSec=15s
LimitNOFILE=1048576
# Every site depends on it: under memory pressure the kernel keeps it in RAM
# (MemoryLow) and kills it last (OOMScoreAdjust), never a swapped-out edge
# answering in tens of seconds while a game server eats the RAM.
MemoryLow=128M
OOMScoreAdjust=-800
Environment=XDG_DATA_HOME=/var/lib/panel-proxy XDG_CONFIG_HOME=/var/lib/panel-proxy/config
StateDirectory=panel-proxy
StateDirectoryMode=0700
RuntimeDirectory=panel-proxy
RuntimeDirectoryMode=0700
# Per-site access logs (the agent reads them for traffic stats).
LogsDirectory=panel-proxy panel-proxy/access
LogsDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# The edge never needs site files or other components' secrets.
InaccessiblePaths=-/srv -/etc/panel-agent -/var/lib/panel-agent -/var/log/panel-agent

[Install]
WantedBy=multi-user.target
