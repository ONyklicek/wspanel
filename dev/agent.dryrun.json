{
  "socket": "var/agent.sock",
  "audit_log": "var/audit.log",
  "state_dir": "var/state",
  "dry_run": true,
  "sites_root": "var/dry-root/srv/sites",
  "trash_dir": "var/dry-root/srv/sites/.trash",
  "php_versions": [
    "8.3",
    "8.4"
  ],
  "db_engines": [
    "mariadb"
  ],
  "fpm_pool_dir": "var/dry-root/etc/php/{version}/fpm/pool.d",
  "proxy_sites_dir": "var/dry-root/etc/panel-proxy/sites",
  "web_sites_dir": "var/dry-root/etc/panel-web/sites",
  "systemd_dir": "var/dry-root/etc/systemd/system",
  "site_config_dir": "var/dry-root/etc/panel-sites",
  "site_run_dir": "var/dry-root/run/wspanel-sites",
  "tmpfiles_dir": "var/dry-root/etc/tmpfiles.d",
  "node_dir": "var/dry-root/opt/fnm/node-versions"
